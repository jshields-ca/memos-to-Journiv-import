# Journiv environment configuration
# Copy this file to .env and fill in the required values before starting.
#
#   cp .env.example .env
#   nano .env   (or your preferred editor)
#   docker compose up -d

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Your server's LAN IP address or hostname (e.g. 192.168.1.100 or myserver.local)
# Do NOT use "localhost" here — the app needs the actual network address.
DOMAIN_NAME=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Port to expose Journiv on (default: 8000)
# Memos typically uses 5230, so 8000 should be free on the same server.
APP_PORT=8000

# Docker image version tag (default: latest)
APP_VERSION=latest

# Celery worker tuning — safe to leave at defaults for single-user use
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=300000
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
